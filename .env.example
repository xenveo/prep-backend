# Copy to .env. Loaded by prisma.config.ts (dotenv) and by the Nest app; validated by src/config/env.ts.
# Never commit real secrets.

NODE_ENV=development
PORT=3000
# all = API + queue processors in one process (dev); api / worker split them (worker: node dist/worker.js)
PROCESS_ROLE=all

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/prep_db?schema=public"
# Unset = in-process queue, pub/sub and rate limits (single process only)
# REDIS_URL=redis://localhost:6379/2
# Prefix for every Redis key, queue and pub/sub channel (pub/sub is server-wide, not per DB).
REDIS_PREFIX=preppilot

STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=.data/storage
# S3_BUCKET=
S3_REGION=ap-south-1
# S3_ENDPOINT=http://localhost:9000
AUDIO_URL_TTL_SEC=300
PUBLIC_API_URL=http://localhost:3000

APP_CANDIDATE_ORIGIN=http://localhost:3001
APP_ADMIN_ORIGIN=http://localhost:3002
# Set to the parent domain in production so both apps share the cookie, e.g. .example.com
# SESSION_COOKIE_DOMAIN=
SESSION_TTL_DAYS=7
# At least 16 characters. Generate with: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string

OTP_TTL_MIN=10
OTP_MAX_TRIES=5
# Dev only: any 6-digit code logs in a seeded or invited user. Refused when NODE_ENV=production.
# AUTH_DEV_ACCEPT_ANY_CODE=true
OTP_REQUESTS_PER_HOUR=5
OTP_IP_REQUESTS_PER_HOUR=20
OTP_RESEND_COOLDOWN_SEC=30
AI_ADMIN_CALLS_PER_HOUR=30

LLM_PROVIDER=fake
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=
STT_PROVIDER=fake
# DEEPGRAM_API_KEY=
TTS_PROVIDER=fake
# ELEVENLABS_API_KEY=
# console | ses | resend
MAIL_PROVIDER=console
MAIL_FROM=no-reply@preppilot.local
# RESEND_API_KEY=
# Dev/test safety: only these get real mail (addresses or @domain), others go to the outbox.
# MAIL_ALLOWLIST=you@example.com,@yourcompany.com
MAIL_RATE_PER_SECOND=2
SES_REGION=ap-south-1

LOG_LEVEL=info
LOG_PRETTY=true
# SENTRY_DSN=
# OTEL_EXPORTER_OTLP_ENDPOINT=
# TRUST_PROXY=1
